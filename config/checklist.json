  "instructions": [
    {
      "row": 1,
      "content": "OOA TLEP Review Checklist – Instructions"
    },
    {
      "row": 3,
      "content": "Purpose : Standardize OOA academic review of department-submitted TLEPs for AY 2026–27."
    },
    {
      "row": 4,
      "content": "Basis : The review checklist is derived from the OOA TLEP template sections: Course Information, POs/PSOs, Course Objectives, COs/BTL, CO–PO mapping, Detailed Syllabus, Session Plan, Sessions Summary, Assessments and Assessment Rubrics."
    },
    {
      "row": 5,
      "content": "Compliant : Requirement is complete, correct and academically aligned."
    },
    {
      "row": 6,
      "content": "Needs Revision : Minor correction, clarification or formatting/content improvement is required."
    },
    {
      "row": 7,
      "content": "Major Revision : Significant academic/structural correction is required before acceptance."
    },
    {
      "row": 8,
      "content": "Non-Compliant : Requirement is absent or does not meet the prescribed requirement."
    },
    {
      "row": 9,
      "content": "NA : Not applicable to the course. NA items are excluded from the score."
    },
    {
      "row": 10,
      "content": "Scoring : Compliant = 2; Needs Revision = 1; Major Revision = 0; Non-Compliant = 0; NA and Not Reviewed are excluded from the denominator."
    },
    {
      "row": 11,
      "content": "OOA principle : Review for both completeness and internal academic consistency. Do not treat completion of a field as evidence of academic alignment."
    },
    {
      "row": 12,
      "content": "Key cross-checks : Course/Curriculum → Credits/L-T-P-E → Syllabus/Module Hours → Session Plan → Learning Hours → CO/BTL → CO–PO/PSO → Assessment/Weightage → Assessment–CO alignment."
    },
    {
      "row": 15,
      "content": "Reviewer's final decision"
    },
    {
      "row": 16,
      "content": "After completing the checklist, the reviewer should record key observations in the Remarks and Department Action Required columns and communicate the consolidated corrections to the department."
    }
  ],
